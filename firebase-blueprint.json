  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user account documents strictly owned by the authenticated user."
    },
    "/publicProfiles/{userId}": {
      "schema": { "$ref": "#/entities/PublicProfile" },
      "description": "Non-PII searchable directory profiles for inviting registered members by acronym or name."
    },
    "/emailDirectory/{emailHash}": {
      "schema": { "$ref": "#/entities/EmailDirectoryEntry" },
      "description": "Zero-PII SHA-256 email hash index keyed by lowercase hex SHA-256 of verified user email for checking if an external invite email already belongs to a registered user."
    },
    "/weddings/{weddingId}": {
      "schema": { "$ref": "#/entities/WeddingProject" },
      "description": "Wedding planning configuration and financial envelope owned by a couple."
    },
    "/weddings/{weddingId}/tasks/{taskId}": {
      "schema": { "$ref": "#/entities/WeddingTaskDoc" },
      "description": "Checklist tasks and paid advances inside a wedding project."
    },
    "/weddings/{weddingId}/guests/{guestId}": {
      "schema": { "$ref": "#/entities/WeddingGuestDoc" },
      "description": "Couple's wedding guest list with RSVP status."
    },
    "/invitations/{invitationId}": {
      "schema": { "$ref": "#/entities/InvitationDoc" },
      "description": "Cross-user wedding invitations readable and updatable by organizer and target guest."
    },
    "/rsvpTokens/{token}": {
      "schema": { "$ref": "#/entities/RsvpTokenDoc" },
