          "type": "string",
          "minLength": 1,
          "maxLength": 10
        },
        "searchable": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "displayName", "acronym", "searchable", "createdAt", "updatedAt"]
    },
    "EmailDirectoryEntry": {
      "title": "EmailDirectoryEntry",
      "description": "Zero-PII SHA-256 email hash index enabling single-read check of whether an email already belongs to a registered app user without exposing emails.",
